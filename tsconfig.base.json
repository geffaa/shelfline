{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": false, "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true, "isolatedModules": true, "noEmit": true
  }
}
