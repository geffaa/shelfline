{
  "name": "@shelfline/pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8210",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview --port 8210 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "e2e": "playwright test",
    "cap:sync": "pnpm build && cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@shelfline/contracts": "workspace:*",
    "@shelfline/money": "workspace:*",
    "@shelfline/pricing": "workspace:*",
    "@shelfline/sync-client": "workspace:*",
    "@shelfline/ui": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
