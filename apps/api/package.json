{
  "name": "@shelfline/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/demo-seed.ts",
    "backup:check": "tsx --env-file-if-exists=../../.env src/ops/backup.ts",
    "perf": "vitest run test/perf.test.ts",
    "e2e-server": "tsx test-support/e2e-server.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@shelfline/contracts": "workspace:*",
    "@shelfline/money": "workspace:*",
    "@shelfline/pricing": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@shelfline/sync-client": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
